# Athena configuration. Copy to .env and fill in; .env is git-ignored.
# The test suite never reads .env and never uses real keys (see tests/conftest.py).

# --- API keys (one per tool in registry/tools.json) ---------------------------------------
# Shodan: tool 'ip_intel_shodan'. https://account.shodan.io/
SHODAN_API_KEY=your_shodan_key_here

# VirusTotal: tool 'url_scan_virustotal'. https://www.virustotal.com/gui/join-us
VT_API_KEY=your_vt_key_here

# AbuseIPDB: tool 'abuse_ip_db'. https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# abuse.ch ThreatFox: tool 'threatfox_ioc' (sent as the Auth-Key header). https://auth.abuse.ch/
THREATFOX_API_KEY=your_threatfox_key_here

# --- Optional settings --------------------------------------------------------------------
# Semantic routing threshold (default 0.30).
ROUTER_THRESHOLD=0.30

# Audit log location (default: logs/audit.jsonl next to server.py).
# ATHENA_AUDIT_PATH=/var/log/athena/audit.jsonl

# Alternative path for this env file. Must be set in the process environment, not inside .env itself.
# ATHENA_ENV_FILE=/etc/athena/athena.env

# --- Agentic mode (v1.3) ------------------------------------------------------------------
# Approval policy + cache settings file (default: config/athena.json; see config/athena.example.json).
# ATHENA_CONFIG=/etc/athena/athena.json

# Response cache shared by ti_query and ti_lookup. Override the config file's cache settings.
# ATHENA_CACHE_DIR=/var/cache/athena
# ATHENA_CACHE_TTL=3600        # seconds; 0 disables the cache
